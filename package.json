{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "lighthouse": "npx --yes unlighthouse@latest --site http://localhost:3000",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.130",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/seo": "^5.3.14",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.15.0",
    "lint-staged": "^15.2.11",
    "nuxt": "^4.5.2",
    "prettier": "^3.4.2",
    "shadcn-nuxt": "^2.8.2",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "~2.2.12"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.3.6",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  }
}
