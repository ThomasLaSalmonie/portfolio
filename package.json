{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^9.15.0",
    "lint-staged": "^15.2.11",
    "nuxt": "^4.5.2",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "~2.2.12",
    "vuetify": "^3.13.3"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "driver.js": "^1.3.6"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  }
}
